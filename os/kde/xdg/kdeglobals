# System-wide defaults for every T3 user (install.sh appends the T3Dark colour groups below this).
[KDE]
LookAndFeelPackage=org.t3.desktop
widgetStyle=Breeze
SingleClick=false
# animations: a touch quicker than default so they feel smooth, not slow
AnimationDurationFactor=0.8

[General]
ColorScheme=T3Dark
AccentColor=63,185,80

[Icons]
Theme=T3

