# T3 frame: red/yellow/green buttons on the left, like macOS
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=kwin4_decoration_qml_t3
ButtonsOnLeft=XIA
ButtonsOnRight=
# no side/bottom frame: apps fill the window (the T3 frame only draws the title bar); the shadow marks the edge
BorderSize=None
BorderSizeAuto=false

# Night light: warm screen after sunset (Bangkok)
[NightColor]
Active=true
Mode=Location
LatitudeFixed=13.7
LongitudeFixed=100.5

# Hot corner top-left: overview of all windows (like Mission Control)
[Effect-overview]
BorderActivate=7

# Hot corner bottom-left: show the desktop (touch it again to bring the windows back)
[ElectricBorders]
BottomLeft=ShowDesktop

[Windows]
Placement=Centered

# Smooth effects: windows genie into the dock, open/close with a soft scale,
# blurred see-through menu bar and dock
[Plugins]
magiclampEnabled=true
squashEnabled=false
scaleEnabled=true
fadeEnabled=false
blurEnabled=true
contrastEnabled=true
slidingpopupsEnabled=true
wobblywindowsEnabled=false
# touch the bottom edge anywhere to bring up the dock (kwin-scripts/t3-dock-edge)
t3-dock-edgeEnabled=true

[Effect-magiclamp]
AnimationDuration=260

[Effect-blur]
BlurStrength=8
NoiseStrength=2
