[General]
Name=T3
Parent=FALLBACK/
# a little room around the text; apps fill the window edge to edge otherwise
TerminalMargin=8
TerminalCenter=false

[Scrolling]
# no scrollbar strip at the window edge; scroll with the mouse wheel or Shift+PgUp/PgDn
ScrollBarPosition=2
HistoryMode=2

[Interaction Options]
# select text with the mouse = copied (Ctrl+C stays "stop the running program"); Ctrl+V pastes
AutoCopySelectedText=true
