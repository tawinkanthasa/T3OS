#!/bin/sh
# t3-open [bench|scope|logbook|shell]  open a T3 panel as its own window.
# Each view gets its own app id, so cog doesn't fold them into one instance.
view="${1:-}"
url="http://127.0.0.1:7300/${view:+?view=$view}"
for i in $(seq 50); do curl -sf http://127.0.0.1:7300/ >/dev/null && break; sleep 0.2; done
exec cog --platform=wl --gapplication-app-id="t3.${view:-main}" --bg-color='#0a0d0bff' "$url"
