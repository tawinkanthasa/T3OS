#!/bin/sh
# Volume / brightness keys with an on-screen bar (a replacing mako notification).
#   t3-osd vol up|down|mute     t3-osd light up|down
tag="string:x-canonical-private-synchronous:t3osd"
case "$1" in
  vol)
    case "$2" in
      up)   pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
      down) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
      mute) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
    esac
    v=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]*%' | head -1 | tr -d %)
    m=$(pactl get-sink-mute @DEFAULT_SINK@ | grep -c yes)
    [ "$m" = 1 ] && label="เสียง: ปิด" || label="เสียง $v%"
    notify-send -a T3 -t 1200 -h "$tag" -h "int:value:${v:-0}" "$label" ;;
  light)
    [ "$2" = up ] && brightnessctl -q set +10% || brightnessctl -q set 10%-
    v=$(( $(brightnessctl get) * 100 / $(brightnessctl max) ))
    notify-send -a T3 -t 1200 -h "$tag" -h "int:value:$v" "ความสว่าง $v%" ;;
esac
