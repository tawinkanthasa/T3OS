#!/usr/bin/env python3
"""Emoji picker (Super+.): pick with fuzzel, copy to clipboard and type it."""
import os, subprocess, unicodedata

RANGES = [(0x1F300, 0x1F5FF), (0x1F600, 0x1F64F), (0x1F680, 0x1F6FF), (0x1F900, 0x1F9FF),
          (0x1FA70, 0x1FAFF), (0x2600, 0x26FF), (0x2700, 0x27BF)]
rows = []
for a, b in RANGES:
    for cp in range(a, b + 1):
        name = unicodedata.name(chr(cp), "")
        if name:
            rows.append(f"{chr(cp)}  {name.lower()}")
cmd = ["fuzzel", "--dmenu", "--prompt", "emoji › ", "--width", "50"]
if os.environ.get("T3_FUZZEL"):
    cmd += ["--config", os.environ["T3_FUZZEL"]]
pick = subprocess.run(cmd, input="\n".join(rows), capture_output=True, text=True).stdout.strip()
if pick:
    ch = pick.split()[0]
    subprocess.run(["wl-copy", ch])
    subprocess.run(["notify-send", "-a", "T3", "-t", "1500", f"คัดลอก {ch} แล้ว"])
