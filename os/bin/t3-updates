#!/bin/sh
# Waybar module: number of pending updates (apt lists are refreshed by Debian's apt-daily timer).
apt_n=$(apt list --upgradable 2>/dev/null | grep -c upgradable)
fp_n=0
command -v flatpak >/dev/null && fp_n=$(flatpak remote-ls --updates 2>/dev/null | wc -l)
n=$((apt_n + fp_n))
if [ "$n" -gt 0 ]; then
  printf '{"text":"upd %s","tooltip":"apt %s · flatpak %s\\nคลิกเพื่ออัปเดต","class":"pending"}\n' "$n" "$apt_n" "$fp_n"
else
  printf '{"text":"","tooltip":"อัปเดตล่าสุดแล้ว","class":"none"}\n'
fi
