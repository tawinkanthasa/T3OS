#!/usr/bin/python3 -I
"""Tidy the boot menu after update-grub (run by T3's update-grub wrapper, root).

Debian names the entries "T3 GNU/Linux, with Linux 6.12.117+deb13-amd64" and
"Windows Boot Manager (on /dev/nvme0n1p1)". This makes them short, gives each a
class for the T3 theme's icon, and puts Windows right after T3:
    T3 / Windows / T3 · Recovery mode / BIOS / UEFI settings
Entry ids ($menuentry_id_option) stay the same, so GRUB_DEFAULT and saved choices keep working.
Only top-level entries are touched. On anything unexpected the file is left as it is.

    t3-grub-names [/boot/grub/grub.cfg]
"""
import os, re, sys, tempfile

HEAD = re.compile(r"^menuentry '((?:[^'\\]|\\.)*)'(.*?)\$menuentry_id_option '([^']+)'(.*)$")


def blocks(lines):
    """Split into chunks: ('entry', [lines], id) for top-level menuentry blocks, ('text', [lines], None) otherwise."""
    out, i = [], 0
    while i < len(lines):
        if lines[i].startswith("menuentry '") and HEAD.match(lines[i]):
            j = i + 1
            while j < len(lines) and lines[j].rstrip("\n") != "}":
                j += 1
            if j == len(lines):
                raise ValueError("unterminated menuentry")
            out.append(("entry", lines[i:j + 1], HEAD.match(lines[i]).group(3)))
            i = j + 1
        else:
            line = lines[i]
            # the BIOS entry sits inside an "if fwsetup --is-supported" block, so it is indented
            m = re.match(r"^(\s+)menuentry '[^']*'(.*\$menuentry_id_option 'uefi-firmware'.*)$", line)
            if m:
                opts = m.group(2) if "--class bios" in m.group(2) else " --class bios" + m.group(2)
                line = f"{m.group(1)}menuentry 'BIOS / UEFI settings'{opts}\n"
            out.append(("text", [line], None))
            i += 1
    return out


def rename(line, title, cls):
    m = HEAD.match(line)
    opts = m.group(2)
    if cls and f"--class {cls} " not in opts + " ":
        opts = f" --class {cls}" + opts
    return f"menuentry '{title}'{opts}$menuentry_id_option '{m.group(3)}'{m.group(4)}\n"


def tidy(text):
    lines = text.splitlines(keepends=True)
    bl = blocks(lines)
    seen = {"t3": 0, "rec": 0, "win": 0}
    first_t3 = None
    for n, (kind, bk, mid) in enumerate(bl):
        if kind != "entry":
            continue
        title = HEAD.match(bk[0]).group(1)
        ver = re.match(r"gnulinux-(.+)-(?:advanced|recovery)-", mid)   # kernel version, from the id
        ver = ver.group(1) if ver else ""
        if mid.startswith("gnulinux") and "recovery" in mid:
            name = "T3 · Recovery mode" if not seen["rec"] else f"T3 · Recovery mode (Linux {ver})"
            seen["rec"] += 1
            bk[0] = rename(bk[0], name, "recovery")
        elif mid.startswith("gnulinux"):
            name = "T3" if not seen["t3"] else f"T3 (Linux {ver})" if ver else "T3 (older)"
            if first_t3 is None:
                first_t3 = n
            seen["t3"] += 1
            bk[0] = rename(bk[0], name, "t3")
        elif "windows" in title.lower():
            bk[0] = rename(bk[0], "Windows" if not seen["win"] else title, "windows")
            seen["win"] += 1
    # Windows right after the first T3 entry
    if first_t3 is not None:
        wins = [b for b in bl if b[0] == "entry" and "--class windows" in b[1][0]]
        rest = [b for b in bl if b not in wins]
        at = rest.index(bl[first_t3]) + 1
        bl = rest[:at] + wins + rest[at:]
    return "".join("".join(b[1]) for b in bl)


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else "/boot/grub/grub.cfg"
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        old = f.read()
    try:
        new = tidy(old)
    except ValueError as e:
        print(f"t3-grub-names: left as is ({e})", file=sys.stderr)
        return 0
    if new == old:
        return 0
    st = os.stat(path)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".grub.cfg.")
    with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape") as f:
        f.write(new)
    os.chmod(tmp, st.st_mode & 0o7777)
    os.replace(tmp, path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
