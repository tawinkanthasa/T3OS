#!/usr/bin/python3 -I
"""Root helper (pkexec, polkit org.t3.boot-set, asks for the password once): change how this computer boots.
  t3-boot-set default <grub menu id>   system to start by default (written to /etc/default/grub.d, update-grub)
  t3-boot-set timeout <0-30>           seconds the boot menu waits (0 = no menu; hold Shift/Esc to see it)
  t3-boot-set next <EFI entry XXXX>    start that system once, on the next restart only (efibootmgr --bootnext)
Every value is checked against what this computer really has."""
import json, re, subprocess, sys
from pathlib import Path

CFG = Path("/etc/default/grub.d/zz-t3-boot.cfg")   # read after t3.cfg, kept across T3 updates


def info():
    return json.loads(subprocess.run(["/usr/share/t3/bin/t3-boot-info"], capture_output=True, text=True,
                                     check=True).stdout)


def fail(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def write_cfg(**values):
    lines = [l for l in (CFG.read_text().splitlines() if CFG.exists() else ["# set by T3 Settings > การบูต"])
             if l.split("=", 1)[0] not in values]
    lines += [f'{k}="{v}"' for k, v in values.items()]
    CFG.write_text("\n".join(lines) + "\n")
    r = subprocess.run(["update-grub"], capture_output=True, text=True)
    if r.returncode:
        fail("update-grub ล้มเหลว: " + (r.stderr.strip().splitlines() or ["?"])[-1])


if len(sys.argv) != 3:
    fail(__doc__)
cmd, arg = sys.argv[1], sys.argv[2]
if cmd == "default":
    if arg != "0" and arg not in {e["id"] for e in info()["grub"]}:
        fail("ไม่มีระบบนี้ในเมนูบูต")
    write_cfg(GRUB_DEFAULT=arg)
elif cmd == "timeout":
    if not re.fullmatch(r"\d{1,2}", arg) or int(arg) > 30:
        fail("เวลาต้องเป็น 0–30 วินาที")
    write_cfg(GRUB_TIMEOUT=arg, GRUB_TIMEOUT_STYLE="hidden" if arg == "0" else "menu")
elif cmd == "next":
    if arg.upper() not in {e["num"].upper() for e in info()["efi"]["entries"]}:
        fail("ไม่มีรายการบูตนี้")
    r = subprocess.run(["efibootmgr", "--bootnext", arg.upper()], capture_output=True, text=True)
    if r.returncode:
        fail("ตั้งไม่สำเร็จ: " + r.stderr.strip())
else:
    fail(__doc__)
print("ok")
