{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 4,
  "modules-left": ["custom/logo", "sway/workspaces", "sway/mode", "custom/bench"],
  "modules-center": ["sway/window"],
  "modules-right": ["custom/ai", "pulseaudio", "network", "battery", "sway/language", "tray", "clock"],

  "custom/logo": { "format": "T3", "tooltip": false, "on-click": "fuzzel --config /usr/share/t3/fuzzel/fuzzel.ini" },
  "sway/workspaces": { "disable-scroll": false, "all-outputs": true },
  "sway/window": { "max-length": 50 },
  "custom/bench": {
    "exec": "curl -sf http://127.0.0.1:7300/api/waybar || echo '{\"text\":\"bench ○\",\"class\":\"off\"}'",
    "return-type": "json", "interval": 2,
    "on-click": "swaymsg exec \"cog --platform=wl 'http://127.0.0.1:7300/?view=bench'\""
  },
  "custom/ai": {
    "exec": "curl -sf 'http://127.0.0.1:7300/api/waybar?part=ai' || echo '{\"text\":\"\"}'",
    "return-type": "json", "interval": 15
  },
  "pulseaudio": { "format": "vol {volume}%", "format-muted": "vol mute", "on-click": "pavucontrol" },
  "network": {
    "format-wifi": "wifi {signalStrength}%", "format-ethernet": "lan", "format-disconnected": "offline",
    "tooltip-format": "{ifname} {ipaddr}", "on-click": "nm-connection-editor"
  },
  "battery": { "format": "bat {capacity}%", "states": { "warning": 25, "critical": 10 } },
  "sway/language": { "format": "{short}" },
  "tray": { "spacing": 8 },
  "clock": { "format": "{:%H:%M}", "tooltip-format": "{:%A %d %B %Y}" }
}
