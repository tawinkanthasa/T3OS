/* T3 installer: dark window, green primary button (matches the T3 design) */
#mainApp { background: #1b1c1f; color: #e6e8ea; }
#sidebarApp { background: #141517; }
#sidebarMenuApp { font-size: 11pt; }
QPushButton { background: transparent; color: #e6e8ea; border: 1px solid #2c3a32; border-radius: 8px; padding: 8px 22px; }
QPushButton:hover { background: #222a25; }
QPushButton:disabled { color: #5f6368; border-color: #26272a; }
#view-button-next { background: #3fb950; color: #06210d; border: 0; font-weight: 600; }
#view-button-next:hover { background: #4cc85d; }
#view-button-next:disabled { background: #1f3a27; color: #5f7a69; }
QComboBox, QLineEdit { background: #141517; color: #e6e8ea; border: 1px solid #2c3a32; border-radius: 8px; padding: 6px 10px; }
QLineEdit:focus, QComboBox:focus { border-color: #3fb950; }
QRadioButton::indicator:checked, QCheckBox::indicator:checked { background: #3fb950; border: 1px solid #3fb950; }
QProgressBar { background: #1c2a21; border: 0; border-radius: 3px; height: 6px; text-align: center; }
QProgressBar::chunk { background: #3fb950; border-radius: 3px; }
