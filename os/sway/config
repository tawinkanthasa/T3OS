# T3 desktop session (Sway).  $t3 = folder holding T3's configs, scripts and UI.
# On the T3 image this is /usr/share/t3; scripts/t3-session.sh rewrites it for dev.
set $t3 /usr/share/t3
set $mod Mod4
set $bin $t3/bin
set $lock swaylock -f -c 0a0d0b

# ---------- look ----------
output * bg #0a0d0b solid_color
font pango:JetBrains Mono 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
smart_gaps on
#                       border  bg      text    indicator child_border
client.focused          #3fb950 #152019 #d3e6da #3fb950   #3fb950
client.focused_inactive #21362b #0f1612 #76917f #21362b   #21362b
client.unfocused        #21362b #0a0d0b #76917f #21362b   #21362b
client.urgent           #f85149 #f85149 #ffffff #f85149   #f85149
seat * xcursor_theme Adwaita 24

input type:keyboard {
    xkb_layout us,th
    xkb_options grp:alt_shift_toggle
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

# ---------- session services ----------
# dark theme for GTK apps (Qt follows via QT_QPA_PLATFORMTHEME=gtk3 in the session env)
exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
exec gsettings set org.gnome.desktop.interface icon-theme Adwaita
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec benchd
exec mako --config $t3/mako/config
exec lxpolkit
exec nm-applet --indicator
exec udiskie --tray --notify
exec wl-paste --watch cliphist store
exec gammastep -l 13.7:100.5 -t 6500:4000
exec fcitx5 -d --replace
exec swayidle -w timeout 600 '$lock' timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep '$lock'
exec waybar -c $t3/waybar/config.jsonc -s $t3/waybar/style.css

# ---------- T3 windows ----------
set $t3open $bin/t3-open
exec $t3open bench
for_window [app_id="^t3\."] border pixel 2
for_window [app_id="^t3\.settings$"] floating enable, resize set 760 560
bindsym $mod+b exec $t3open bench
bindsym $mod+s exec $t3open scope
bindsym $mod+l exec $t3open logbook
bindsym $mod+t exec $t3open
bindsym $mod+comma exec $t3open settings

# ---------- apps ----------
set $chrome google-chrome-stable --ozone-platform-hint=auto
bindsym $mod+space exec fuzzel --config $t3/fuzzel/fuzzel.ini
bindsym $mod+Return exec foot
bindsym $mod+e exec thunar
bindsym $mod+w exec $chrome
bindsym $mod+Shift+w exec firefox-esr
bindsym $mod+c exec code --ozone-platform-hint=auto
bindsym $mod+a exec gnome-software

# ---------- tools ----------
bindsym $mod+v exec $bin/t3-clip
bindsym $mod+period exec $bin/t3-emoji
bindsym Print exec grim -g "$(slurp)" - | wl-copy && notify-send -a T3 -t 1500 "คัดลอกภาพแล้ว"
bindsym $mod+Shift+s exec mkdir -p ~/Pictures && grim -g "$(slurp)" ~/Pictures/t3-$(date +%Y%m%d-%H%M%S).png && notify-send -a T3 -t 1500 "บันทึกภาพแล้ว" "~/Pictures"
bindsym $mod+Shift+r exec $bin/t3-record
bindsym $mod+Escape exec $lock
bindsym $mod+Shift+e exec $bin/t3-power
bindsym XF86AudioRaiseVolume exec $bin/t3-osd vol up
bindsym XF86AudioLowerVolume exec $bin/t3-osd vol down
bindsym XF86AudioMute exec $bin/t3-osd vol mute
bindsym XF86MonBrightnessUp exec $bin/t3-osd light up
bindsym XF86MonBrightnessDown exec $bin/t3-osd light down
bindsym XF86PowerOff exec $bin/t3-power

# ---------- windows ----------
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+backslash splith
bindsym $mod+minus splitv
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
floating_modifier $mod normal
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left resize shrink width 20px
    bindsym Right resize grow width 20px
    bindsym Up resize shrink height 20px
    bindsym Down resize grow height 20px
    bindsym Escape mode "default"
    bindsym Return mode "default"
}
for_window [app_id="pavucontrol|blueman-manager|nm-connection-editor|wdisplays|org.fcitx.fcitx5-config-qt"] floating enable
for_window [title="^T3 update$"] floating enable, resize set 800 500

# ---------- workspaces ----------
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# ---------- session ----------
bindsym $mod+Shift+c reload
