# T3 desktop: KDE Plasma 6, laid out Mac-style (top menu bar + floating dock + app grid).
# Used by scripts/setup-desktop.sh and the live-build ISO.
# -- Plasma core + login screen (kwallet unlocks with the login password, so Chrome never asks)
kde-plasma-desktop plasma-workspace sddm sddm-theme-breeze kde-config-sddm libpam-kwallet5 kwalletmanager systemd-timesyncd
xdg-desktop-portal-kde xwayland appmenu-gtk3-module kde-config-gtk-style breeze-gtk-theme plasma-widgets-addons
# -- system settings backends: Wi-Fi, sound, Bluetooth, power, screens, printers, phone link
plasma-nm plasma-pa bluedevil powerdevil kscreen print-manager kdeconnect plasma-systemmonitor
# -- app store + firmware updates (Flathub enabled by setup-extras.sh)
flatpak plasma-discover plasma-discover-backend-flatpak plasma-discover-backend-fwupd fwupd
# -- everyday apps: files, terminal, drop-down terminal (F12), editor, archives, photos, PDF, video,
#    screenshots/recording, calculator, search, disk usage, partitions, office
dolphin konsole yakuake kate ark gwenview okular haruna kde-spectacle kcalc kfind filelight partitionmanager
ffmpegthumbs kdegraphics-thumbnailers
libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-qt6 libreoffice-l10n-th
firefox-esr
# -- T3 panels + helpers
cog curl jq libnotify-bin usbutils kdialog pciutils mokutil efibootmgr os-prober
# -- fonts (Thai + emoji + code)
fonts-noto-core fonts-noto-color-emoji fonts-thai-tlwg fonts-jetbrains-mono
# -- Thai everywhere: locale, spell check, Firefox in Thai
locales hunspell-th hunspell-en-us firefox-esr-l10n-th
