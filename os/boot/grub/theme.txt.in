# T3 boot menu (rendered by os/boot/render.sh, which fills in @TITLE@ and @HINT@)
# Entry names and order come from t3-grub-names: T3, Windows, recovery, BIOS.
# Icons: icons/<class>.png, the first --class of an entry that has a picture.
desktop-image: "background.png"
desktop-color: "#0a0c0d"
title-text: ""
terminal-font: "DejaVu Sans Mono Regular 16"
terminal-box: "term_*.png"

+ image { left = 50%-48 top = 14% width = 96 height = 96 file = "logo.png" }
+ label { left = 0 top = 14%+120 width = 100% height = 24 align = "center"
          text = "@TITLE@" color = "#8fa89a" font = "DejaVu Sans Mono Regular 18" }

+ boot_menu {
  left = 50%-360 width = 720 top = 33% height = 352
  item_font = "DejaVu Sans Mono Regular 24" item_color = "#c9cdd1"
  selected_item_font = "DejaVu Sans Mono Bold 24" selected_item_color = "#ffffff"
  item_height = 76 item_padding = 30 item_spacing = 12
  icon_width = 40 icon_height = 40 item_icon_space = 24
  item_pixmap_style = "item_*.png" selected_item_pixmap_style = "select_*.png"
  scrollbar = false
}

+ progress_bar { id = "__timeout__" left = 50%-360 top = 33%+368 width = 720 height = 4
  fg_color = "#3fb950" bg_color = "#1c2a21" border_color = "#1c2a21" show_text = false text = "" font = "DejaVu Sans Mono Regular 16" }
+ label { left = 50%-360 top = 33%+400 width = 720 height = 22 align = "left"
          text = "@HINT@" color = "#8fa89a" font = "DejaVu Sans Mono Regular 16" }
+ label { id = "__timeout__" left = 50%-360 top = 33%+400 width = 720 height = 22 align = "right"
          text = "@TIMEOUT_NOTIFICATION_MIDDLE@" color = "#8fa89a" font = "DejaVu Sans Mono Regular 16" }
