# T3 boot menu (rendered by os/boot/render.sh, which fills in @TITLE@ and @HINT@)
desktop-image: "background.png"
desktop-color: "#0a0c0d"
title-text: ""
terminal-font: "DejaVu Sans Mono Regular 16"
terminal-box: "term_*.png"

+ image { left = 50%-36 top = 15% width = 72 height = 72 file = "logo.png" }
+ label { left = 0 top = 15%+88 width = 100% height = 24 align = "center"
          text = "@TITLE@" color = "#8fa89a" font = "DejaVu Sans Mono Regular 14" }

+ boot_menu {
  left = 50%-320 width = 640 top = 35% height = 320
  item_font = "DejaVu Sans Mono Regular 18" item_color = "#c9cdd1"
  selected_item_font = "DejaVu Sans Mono Bold 18" selected_item_color = "#ffffff"
  item_height = 52 item_padding = 20 item_spacing = 6
  icon_width = 0 icon_height = 0 item_icon_space = 0
  item_pixmap_style = "item_*.png" selected_item_pixmap_style = "select_*.png"
  scrollbar = false
}

+ progress_bar { id = "__timeout__" left = 50%-320 top = 35%+344 width = 640 height = 3
  fg_color = "#3fb950" bg_color = "#1c2a21" border_color = "#1c2a21" show_text = false }
+ label { left = 50%-320 top = 35%+358 width = 640 height = 20 align = "left"
          text = "@HINT@" color = "#8fa89a" font = "DejaVu Sans Mono Regular 13" }
+ label { id = "__timeout__" left = 50%-320 top = 35%+358 width = 640 height = 20 align = "right"
          text = "@TIMEOUT_NOTIFICATION_MIDDLE@" color = "#8fa89a" font = "DejaVu Sans Mono Regular 13" }
